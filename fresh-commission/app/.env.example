# Copy to .env.local for development. In production these are set in the
# Vercel project's Environment Variables settings.

# Postgres connection string. Apply schema.sql to this database before
# setting this — until it is set, /api/register returns 503 honestly
# instead of pretending to work.
DATABASE_URL=

# AgentMail API key for the admissions.almadeenah@agentmail.to inbox.
# Used server-side only (app/api/register/route.ts) — never exposed to the
# client. Without it, registration still persists to the database but the
# confirmation/notification emails are skipped and logged as such.
AGENTMAIL_API_KEY=
